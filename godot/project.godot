; Engine configuration file.
config_version=5

[application]

config/name="灯骸夜行"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://src/main.tscn"
config/icon="res://assets/app_icon.png"

[autoload]

Playtest="*res://src/playtest.gd"
Audio="*res://src/audio.gd"

[display]

